Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Table (5 cm grid)
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 10
      Plane: XY
      Reference Frame: touch/base
      Color: 120; 120; 120
      Alpha: 0.4
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Touch
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /touch/robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: touch
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Target and workspace
      Enabled: true
      Topic:
        Value: /touch/teleop/markers
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 235; 235; 235
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Operator view
      Distance: 0.55
      Focal Point:
        X: 0.0
        Y: 0.07
        Z: -0.03
      Pitch: 0.45
      Yaw: 4.712
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1100
  Hide Left Dock: true
  Hide Right Dock: true

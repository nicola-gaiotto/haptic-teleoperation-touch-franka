<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>touch_teleop</name>
  <version>0.3.0</version>
  <description>
    Velocity teleoperation of the 3D Systems Touch: converts geometry_msgs/Twist velocity
    commands (e.g. from teleop_twist_keyboard) into a continuously moving Cartesian target
    for touch_raw_driver, with workspace limits, a control panel with arrow keys and a 3D
    view of the Touch model in RViz.
  </description>
  <maintainer email="your.email@example.com">Nicola Gaiotto</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>touch_raw_driver</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>touch_raw_driver</name>
  <version>0.2.0</version>
  <description>
    ROS 2 driver for the 3D Systems Touch haptic device that commands the motors directly
    over USB (reverse-engineered HID protocol), without OpenHaptics. Publishes the stylus
    position in metres and moves the stylus to Cartesian or joint targets.
  </description>
  <maintainer email="your.email@example.com">Nicola Gaiotto</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-usb</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
